# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=replace-with-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=postgresql://fpd_user:fpd_password@localhost:5432/fake_payment_detector

# --- CORS (comma-separated in real .env parsing via pydantic-settings JSON or override) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8
